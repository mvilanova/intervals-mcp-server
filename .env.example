# Intervals.icu MCP Server configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is listed in .gitignore and must never be committed.
# On FastMCP Cloud, set these values as environment variables in the project settings instead.

# --- Required ---------------------------------------------------------------

# Intervals.icu API key: intervals.icu -> Settings -> Developer Settings -> API Key
API_KEY=your_intervals_api_key_here

# Intervals.icu athlete ID, e.g. i123456 (shown in the URL of your profile page)
ATHLETE_ID=your_athlete_id_here

# The API_KEY and ATHLETE_ID are used as defaults for all API calls
# when these parameters are not explicitly provided to the tool functions.

# --- Optional ---------------------------------------------------------------

# Base URL of the Intervals.icu API
# INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# Transport: stdio (default, Claude Desktop), sse or streamable-http
# MCP_TRANSPORT=stdio

# Host, port and log level when running with sse or streamable-http
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000
# FASTMCP_LOG_LEVEL=INFO

# Mount path for the SSE transport
# MCP_SSE_MOUNT_PATH=/
