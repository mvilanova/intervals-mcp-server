# Copy to web/.env for local development.
# Matches the Postgres container in deploy/docker-compose.dev.yml.
# .env is loaded by both Prisma CLI and Next.js.

DATABASE_URL="postgresql://dashboard:dashboard@localhost:5433/dashboard"

# PIN you'll type at /login.
DASHBOARD_PIN=123456

# Seed user — used by `npm run db:seed`.
SEED_USER_EMAIL=you@example.com
SEED_TARGET_WEIGHT=65
# SEED_TARGET_DATE=2026-12-31

# Intervals.icu — not needed until Week 2.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
