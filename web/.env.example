# Copy to web/.env for local development.
# Matches the Postgres container in deploy/docker-compose.dev.yml.
# .env is loaded by both Prisma CLI and Next.js.

DATABASE_URL="postgresql://dashboard:dashboard@localhost:5433/dashboard"

# PIN you'll type at /login.
DASHBOARD_PIN=123456

# 32+ char random secret used to HMAC-sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Seed user — used by `npm run db:seed`.
SEED_USER_EMAIL=you@example.com
SEED_TARGET_WEIGHT=65
# SEED_TARGET_DATE=2026-12-31

# Intervals.icu — not needed until Week 2.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Anthropic API — optional, and a privacy decision: when set, each
# daily summary sends that day's metrics (training load, recovery
# numbers, weight, meal-log statuses) to Anthropic to generate a
# one-paragraph readout shown at the top of /. Cached per-day in the
# DailySummary table, regenerated only when you click Refresh. Leave
# blank to hide the card and keep all health data local.
ANTHROPIC_API_KEY=
