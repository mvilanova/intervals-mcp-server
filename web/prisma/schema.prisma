generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  targetWeight   Float?
  targetDate     DateTime?
  baselineRhr    Int?
  createdAt      DateTime       @default(now())
  weightLogs     WeightLog[]
  mealLogs       MealLog[]
  dailyMetrics   DailyMetrics[]
  activities     Activity[]
  dailySummaries DailySummary[]
}

model WeightLog {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date
  weightKg Float
  notes    String?
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model MealLog {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date
  mealType String
  status   String
  notes    String?
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, date, mealType])
}

model DailyMetrics {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  ctl          Float?
  atl          Float?
  rampRate     Float?
  rhr          Int?
  hrv          Float?
  sleepHours   Float?
  sleepScore   Int?
  steps        Int?
  kcalConsumed Int?
  carbsGrams   Float?
  proteinGrams Float?
  fatGrams     Float?
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model SyncRun {
  id              String          @id @default(cuid())
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  mode            String
  wellnessUpserts Int             @default(0)
  activityUpserts Int             @default(0)
  weightUpserts   Int             @default(0)
  errors          String[]        @default([])
  sources         SyncSourceRun[]

  @@index([startedAt])
}

model SyncSourceRun {
  id             String    @id @default(cuid())
  syncRunId      String
  syncRun        SyncRun   @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  source         String
  status         String
  requestedFrom  DateTime  @db.Date
  requestedTo    DateTime  @db.Date
  fetchedCount   Int?
  parsedCount    Int?
  upsertedCount  Int       @default(0)
  unchangedCount Int       @default(0)
  skippedCount   Int       @default(0)
  httpStatus     Int?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@unique([syncRunId, source])
  @@index([syncRunId])
  @@index([source, startedAt])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  intervalsId String
  date        DateTime @db.Date
  type        String
  durationMin Float?
  tss         Float?
  distanceKm  Float?
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, intervalsId])
}

model DailySummary {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  summaryText String
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}
