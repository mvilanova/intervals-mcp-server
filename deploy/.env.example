# Copy to deploy/.env on the VPS and fill in real values.
# Never commit deploy/.env to git.

POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dashboard
DATABASE_URL=postgresql://dashboard:change-me-strong-password@postgres:5432/dashboard

# 6-digit PIN you'll type on first visit. Single-user auth for v1.
DASHBOARD_PIN=000000

# From your Intervals.icu account profile.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
